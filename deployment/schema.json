      "default": true
    },
    "csharp.newLinesForBracesInAnonymousTypes": {
      "description": "Sets the CSharpFormattingOptions.NewLinesForBracesInAnonymousTypes option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInControlBlocks": {
      "description": "Sets the CSharpFormattingOptions.NewLinesForBracesInControlBlocks option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInLambdaExpressionBody": {
      "description": "Sets the CSharpFormattingOptions.NewLinesForBracesInLambdaExpressionBody option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInMethods": {
