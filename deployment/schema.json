      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInProperties": {
      "description": "Sets the CSharpFormattingOptions.NewLinesForBracesInProperties option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInTypes": {
      "description": "Sets the CSharpFormattingOptions.NewLinesForBracesInTypes option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.spaceAfterCast": {
      "description": "Sets the CSharpFormattingOptions.SpaceAfterCast option of Roslyn.",
      "type": "boolean",
      "default": false
