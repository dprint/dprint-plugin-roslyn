{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugins.dprint.dev/dprint/dprint-plugin-roslyn/0.0.0/schema.json",
  "type": "object",
  "definitions": {
    "indentWidth": {
      "description": "The number of characters for an indent.",
      "type": "number",
      "default": 4
    },
    "useTabs": {
      "description": "Whether to use tabs (true) or spaces (false).",
      "type": "boolean",
      "default": false
    },
    "newLineKind": {
      "description": "The kind of newline to use.",
      "type": "string",
      "default": "auto",
      "oneOf": [
        {
          "const": "auto",
          "description": "For each file, uses the newline kind found at the end of the last line."
        },
        {
          "const": "crlf",
          "description": "Uses carriage return, line feed."
        },
        {
          "const": "lf",
          "description": "Uses line feed."
        },
        {
          "const": "system",
          "description": "Uses line feed, because the plugin is unable to see the system standard."
        }
      ]
    }
  },
  "properties": {
    "locked": {
      "description": "Whether the configuration is not allowed to be overriden or extended.",
      "type": "boolean"
    },
    "indentWidth": {
      "$ref": "#/definitions/indentWidth"
    },
    "useTabs": {
      "$ref": "#/definitions/useTabs"
    },
    "newLineKind": {
      "$ref": "#/definitions/newLineKind"
    },
    "csharp.indentWidth": {
      "$ref": "#/definitions/indentWidth"
    },
    "csharp.useTabs": {
      "$ref": "#/definitions/useTabs"
    },
    "csharp.newLineKind": {
      "$ref": "#/definitions/newLineKind"
    },
    "visualBasic.indentWidth": {
      "$ref": "#/definitions/indentWidth"
    },
    "visualBasic.useTabs": {
      "$ref": "#/definitions/useTabs"
    },
    "visualBasic.newLineKind": {
      "$ref": "#/definitions/newLineKind"
    },
    "csharp.enabled": {
      "description": "Whether to format C# files.",
      "type": "boolean",
      "default": true
    },
    "visualBasic.enabled": {
      "description": "Whether to format Visual Basic files.",
      "type": "boolean",
      "default": true
    },
    "csharp.indentBlock": {
      "description": "Sets the CSharpFormattingOptions.IndentBlock option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.indentBraces": {
      "description": "Sets the CSharpFormattingOptions.IndentBraces option of Roslyn.",
      "type": "boolean",
      "default": false
    },
    "csharp.indentSwitchCaseSection": {
      "description": "Sets the CSharpFormattingOptions.IndentSwitchCaseSection option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.indentSwitchCaseSectionWhenBlock": {
      "description": "Sets the CSharpFormattingOptions.IndentSwitchCaseSectionWhenBlock option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.indentSwitchSection": {
      "description": "Sets the CSharpFormattingOptions.IndentSwitchSection option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.labelPositioning": {
      "description": "Sets the CSharpFormattingOptions.LabelPositioning option of Roslyn.",
      "type": "string",
      "default": "oneLess",
      "enum": [
        "leftMost",
        "oneLess",
        "noIndent"
      ]
    },
    "csharp.newLineForCatch": {
      "description": "Sets the CSharpFormattingOptions.NewLineForCatch option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLineForClausesInQuery": {
      "description": "Sets the CSharpFormattingOptions.NewLineForClausesInQuery option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLineForElse": {
      "description": "Sets the CSharpFormattingOptions.NewLineForElse option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLineForFinally": {
      "description": "Sets the CSharpFormattingOptions.NewLineForFinally option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLineForMembersInAnonymousTypes": {
      "description": "Sets the CSharpFormattingOptions.NewLineForMembersInAnonymousTypes option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLineForMembersInObjectInit": {
      "description": "Sets the CSharpFormattingOptions.NewLineForMembersInObjectInit option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInAccessors": {
      "description": "Sets the CSharpFormattingOptions.NewLinesForBracesInAccessors option of Roslyn.",
      "type": "boolean",
      "default": true
    },
    "csharp.newLinesForBracesInAnonymousMethods": {
